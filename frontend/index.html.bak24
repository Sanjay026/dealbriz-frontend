        <div class="hb-cat-pills-scroll" id="homeCatPillsScroll"></div>
      </div>
    </div>

    <section class="hb-section hb-section--cats" id="browseCategories">
    <div class="hb-wrap">
      <div class="dbz-cats" data-dbz-cats aria-labelledby="dbz-cats-title">
