<div id="emiUnavailableModal" class="modal-overlay hidden">
  <div class="modal-box emi-unavailable-box">
    <button class="modal-close" onclick="closeEmiUnavailableModal()"><i class="fa fa-times"></i></button>
    <div class="emi-unavailable-icon"><i class="fas fa-map-location-dot"></i></div>
    <h3 id="emiUnavailableHeading">EMI not available here yet</h3>
    <p id="emiUnavailableText">EMI is not available in your area yet.</p>
    <p id="emiUnavailableWhere" class="emi-unavailable-where hidden"></p>
    <p class="emi-unavailable-note">
      You can still buy this item directly — message the seller to arrange payment.
      We're adding financing partners in more areas.
    </p>
    <div class="emi-unavailable-actions">
      <button class="btn-primary" onclick="closeEmiUnavailableModal()">Got it</button>
      <button class="btn-sm" onclick="closeEmiUnavailableModal(); showPage('help')">Help Centre</button>
    </div>
  </div>
</div>

<div id="legalPeekModal" class="modal-overlay hidden">
  <div class="modal-box legal-peek-box">
    <div class="legal-peek-head">
      <div>
        <strong id="legalPeekTitle">Terms of Service</strong>
        <span id="legalPeekUpdated"></span>
      </div>
      <button class="modal-close" onclick="closeLegalPeek()" aria-label="Close"><i class="fas fa-xmark"></i></button>
    </div>

    <div class="legal-peek-body" id="legalPeekBody"></div>

    <div class="legal-peek-foot">
      <a href="#" id="legalPeekFull" onclick="openLegalFull(); return false;">Open full page</a>
      <button class="btn-primary" onclick="closeLegalPeek()">Done</button>
    </div>
  </div>
</div>

<div id="partyInfoModal" class="modal-overlay hidden">
  <div class="modal-box party-info-box">
    <button class="modal-close" onclick="closePartyInfo()" aria-label="Close"><i class="fas fa-xmark"></i></button>

    <div class="party-info-head">
      <img id="partyInfoAvatar" src="" alt="">
      <div>
        <strong id="partyInfoName">Seller</strong>
        <span id="partyInfoMeta"></span>
      </div>
    </div>

    <div class="party-info-rows" id="partyInfoRows"></div>

    <p class="party-info-note">
      <i class="fas fa-shield-halved"></i>
      Meet in a public place and never pay before you have the item.
    </p>

    <div class="party-info-actions">
      <button class="btn-secondary" onclick="closePartyInfo()">Close</button>
      <button class="btn-danger" id="partyInfoReportBtn" onclick="reportFromChat()">
        <i class="fas fa-flag"></i> Report Seller
      </button>
    </div>
  </div>
</div>

<div id="cameraModal" class="modal-overlay hidden">
  <div class="modal-box camera-box">
    <div class="camera-head">
      <strong>Take a photo</strong>
      <button class="modal-close" onclick="closeCamera()" aria-label="Cancel"><i class="fas fa-xmark"></i></button>
    </div>

    <div class="camera-stage">
      <video id="cameraVideo" autoplay playsinline muted></video>
      <div class="camera-ring"></div>
    </div>

    <p class="camera-hint" id="cameraHint">Line yourself up, then take the shot.</p>

    <div class="camera-actions">
      <button class="btn-secondary" onclick="closeCamera()">Cancel</button>
      <button class="btn-secondary hidden" id="cameraFlipBtn" onclick="flipCamera()"><i class="fas fa-camera-rotate"></i> Flip</button>
      <button class="btn-primary" id="cameraShootBtn" onclick="captureCameraPhoto()"><i class="fas fa-camera"></i> Capture</button>
    </div>
  </div>
</div>

<div id="avatarCropModal" class="modal-overlay hidden">
  <div class="modal-box avatar-crop-box">
    <div class="avatar-crop-head">
      <strong>Adjust your picture</strong>
      <button class="modal-close" onclick="closeAvatarCrop()" aria-label="Cancel"><i class="fas fa-xmark"></i></button>
    </div>

    <div class="avatar-crop-stage" id="avatarCropStage">
      <canvas id="avatarCropCanvas" width="320" height="320"></canvas>
      <div class="avatar-crop-ring"></div>
    </div>

    <label class="avatar-crop-zoom">
      <i class="fas fa-magnifying-glass-minus"></i>
      <input type="range" id="avatarZoom" min="1" max="3" step="0.01" value="1" oninput="drawAvatarCrop()">
      <i class="fas fa-magnifying-glass-plus"></i>
    </label>
    <p class="avatar-crop-hint">Drag the photo to reposition it.</p>

    <div class="avatar-crop-actions">
      <button class="btn-secondary" onclick="closeAvatarCrop()">Cancel</button>
      <button class="btn-primary" id="avatarCropSave" onclick="saveAvatarCrop()">Save picture</button>
    </div>
  </div>
</div>

<button id="chatMiniBubble" class="chat-mini-bubble hidden" onclick="restoreChat()">
  <i class="fas fa-comment-dots"></i>
  <span class="chat-mini-name">Chat</span>
  <i class="fas fa-chevron-up chat-mini-caret"></i>
</button>

<button id="botFab" class="bot-fab" onclick="toggleBot()" aria-label="Open support chat">
  <i class="fas fa-headset"></i>
</button>

<div id="botPanel" class="bot-panel hidden" role="dialog" aria-label="Support assistant">
  <div class="bot-head">
    <div class="bot-head-title">
      <span class="bot-avatar"><i class="fas fa-headset"></i></span>
      <div>
        <strong>DealBriz Assistant</strong>
        <small>Answers from our help centre</small>
      </div>
    </div>
    <button class="bot-close" onclick="toggleBot(false)" aria-label="Close"><i class="fa fa-times"></i></button>
  </div>

  <div id="botLog" class="bot-log" aria-live="polite"></div>

  <div id="botChips" class="bot-chips"></div>

  <form autocomplete="off" class="bot-input" onsubmit="sendBotMessage(event)">
    <input type="text" id="botInput" placeholder="Type your question..." autocomplete="off" maxlength="500">
    <button type="submit" class="bot-send" aria-label="Send"><i class="fas fa-paper-plane"></i></button>
  </form>
</div>

</body>
</html>
