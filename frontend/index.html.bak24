<div id="reportModal" class="modal-overlay hidden">
  <div class="modal-box" data-enter-flow>
    <button class="modal-close" onclick="closeReportModal()"><i class="fa fa-times"></i></button>
    <h3 id="reportTitle" style="margin:0 0 6px">Report this seller</h3>
    <p style="font-size:13px;color:var(--text-muted);margin:0 0 14px">
      Reports go to the DealBriz moderation team. Please only report genuine concerns.
    </p>
    <div class="form-group">
      <label>Reason <span class="req">*</span></label>
      <select id="reportReason">
        <option value="">Select a reason...</option>
        <option value="fraud_scam">Fraud or scam</option>
        <option value="fake_listing">Fake or misleading listing</option>
        <option value="counterfeit">Counterfeit goods</option>
        <option value="harassment">Harassment or abusive behaviour</option>
        <option value="prohibited_item">Prohibited item</option>
        <option value="payment_issue">Payment problem</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="form-group">
      <label>What happened? (optional)</label>
      <textarea id="reportDetails" rows="4" maxlength="2000"
                placeholder="Add any details that would help our team investigate."></textarea>
    </div>
    <div id="reportError" class="auth-error hidden"></div>
    <button class="btn-primary" style="width:100%;margin-top:12px" data-enter-submit onclick="submitReport()">
      <i class="fas fa-flag"></i> Submit Report
    </button>
  </div>
</div>

<div id="locationModal" class="modal-overlay hidden">
  <div class="modal-box loc-box">
    <button class="modal-close" onclick="closeLocationPicker()"><i class="fa fa-times"></i></button>
    <h3 style="margin:0 0 6px">Choose your area</h3>
    <p style="font-size:13px;color:var(--text-muted);margin:0 0 14px">
      We'll show listings from this district first.
    </p>
    <div class="form-group">
      <input type="text" id="locSearch" placeholder="Search city or district..." oninput="renderLocationList()" autocomplete="off">
    </div>
    <button class="loc-detect" onclick="detectMyLocation()"><i class="fas fa-crosshairs"></i> Use my current location</button>
    <div id="locList" class="loc-list"></div>
  </div>
</div>

<div id="featureModal" class="modal-overlay hidden">
  <div class="modal-box feature-box">
    <button class="modal-close" onclick="closeFeatureModal()"><i class="fa fa-times"></i></button>
    <h3 style="margin:0 0 6px"><i class="fas fa-bolt" style="color:var(--gold)"></i> Show at Top</h3>
    <p style="font-size:13px;color:var(--text-muted);margin:0 0 4px" id="featureListingTitle"></p>
    <p style="font-size:13px;color:var(--text-muted);margin:0 0 16px">
      Your listing appears above others when buyers browse or search its category.
    </p>
    <div id="featurePlans" class="feature-plans"></div>
    <div id="featureError" class="auth-error hidden"></div>
    <button class="btn-primary" style="width:100%;margin-top:14px" onclick="confirmFeature()">
      <i class="fas fa-bolt"></i> <span id="featureConfirmLabel">Show at Top</span>
    </button>
    <button id="featureRemoveBtn" class="btn-sm btn-sm-red hidden" style="width:100%;margin-top:8px" onclick="removeFeature()">
      Stop showing at top
    </button>
    <p style="font-size:11px;color:var(--text-light);margin:12px 0 0;line-height:1.5">
      Promotion affects position only, never which listings a buyer sees. Prices shown are
      indicative &mdash; payment is not yet enabled, so promotion is currently free.
    </p>
  </div>
</div>

<div id="termsModal" class="modal-overlay hidden">
  <div class="modal-box terms-box">
    <button class="modal-close" onclick="closeTermsModal()"><i class="fa fa-times"></i></button>
    <h3 id="termsModalTitle" style="margin:0 0 4px">Terms of Service</h3>
    <p id="termsModalMeta" style="font-size:12px;color:var(--text-muted);margin:0 0 16px"></p>
    <div id="termsModalBody" class="terms-body">
      <div style="text-align:center;padding:30px;color:var(--text-muted)"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
    </div>
  </div>
</div>

<div id="faqEditorModal" class="modal-overlay hidden">
  <div class="modal-box faq-editor-box">
    <button class="modal-close" onclick="closeFaqEditor()"><i class="fa fa-times"></i></button>
    <h3 id="faqEditorTitle" style="margin:0 0 16px">Add FAQ</h3>
    <div class="form-group">
      <label for="faqQuestion">Question</label>
      <input type="text" id="faqQuestion" maxlength="300" placeholder="How do I ...?" autocomplete="off">
    </div>
    <div class="form-group">
      <label for="faqAnswer">Answer</label>
      <textarea id="faqAnswer" rows="7" placeholder="Supports **bold**, *italic*, __underline__, and - / 1. lists"></textarea>
    </div>
    <div class="form-group">
      <label for="faqKeywords">Search keywords <span class="opt">(helps the chatbot match this)</span></label>
      <input type="text" id="faqKeywords" maxlength="400" placeholder="sell, post, list, create, upload" autocomplete="off">
      <small class="field-hint">Words people actually type when asking this, separated by spaces or commas.</small>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="faqCategory">Category</label>
        <select id="faqCategory"></select>
      </div>
      <div class="form-group">
        <label for="faqSortOrder">Sort order</label>
        <input type="number" id="faqSortOrder" value="0" min="0" autocomplete="off">
      </div>
    </div>
    <label class="toggle-label"><input type="checkbox" id="faqPublished" checked> Published (the chatbot can answer with this)</label>
    <label class="toggle-label"><input type="checkbox" id="faqShowInHelp" checked> Also show on the public Help Centre page</label>
    <small class="field-hint">Untick the second box for bulk-imported answers you want the chatbot to know but that would clutter the Help Centre.</small>
    <div id="faqEditorError" class="auth-error hidden"></div>
    <input type="hidden" id="faqEditId">
    <button class="btn-primary" style="width:100%;margin-top:14px" onclick="saveFaq()"><i class="fas fa-save"></i> Save FAQ</button>
  </div>
</div>

<div id="blogEditorModal" class="modal-overlay hidden">
  <div class="modal-box faq-editor-box">
    <button class="modal-close" onclick="closeBlogEditor()"><i class="fa fa-times"></i></button>
    <h3 id="blogEditorTitle" style="margin:0 0 16px">New Post</h3>
    <div class="form-group">
      <label for="blogTitle">Title</label>
      <input type="text" id="blogTitle" maxlength="200" placeholder="Post title" autocomplete="off">
    </div>
    <div class="form-group">
      <label for="blogExcerpt">Excerpt <span class="opt">(shown in the list)</span></label>
      <textarea id="blogExcerpt" rows="2" maxlength="400" placeholder="One or two lines summarising the post"></textarea>
    </div>
    <div class="form-group">
      <label for="blogBody">Body</label>
      <textarea id="blogBody" rows="10" placeholder="Supports **bold**, *italic*, __underline__, and - / 1. lists"></textarea>
    </div>
    <label class="toggle-label"><input type="checkbox" id="blogPublished" checked> Published (visible on the Blog page)</label>
    <div id="blogEditorError" class="auth-error hidden"></div>
    <input type="hidden" id="blogEditId">
    <button class="btn-primary" style="width:100%;margin-top:14px" onclick="saveBlogPost()"><i class="fas fa-save"></i> Save Post</button>
  </div>
</div>

