                <line x1="105" y1="103" x2="155" y2="103" stroke="#FFF" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="105" y1="109" x2="135" y2="109" stroke="#93C5FD" stroke-width="2" stroke-linecap="round"/>
                <circle cx="170" cy="106" r="4" fill="#10B981"/>
              </g>
              <g style="filter:drop-shadow(0 6px 10px rgba(11,27,61,0.1))">
                <rect x="55" y="125" width="110" height="26" rx="13" fill="#0B1B3D"/>
                <rect x="68" y="133" width="7" height="6" rx="1.5" fill="#FFF"/>
                <path d="M70 133V131C70 130 71 129 72 129C73 129 74 130 74 131V133" stroke="#FFF" stroke-width="1.2"/>
                <text x="80" y="142" font-family="'Plus Jakarta Sans',sans-serif" font-size="9.5" font-weight="700" fill="#FFF">Phone Hidden</text>
              </g>
            </svg>
