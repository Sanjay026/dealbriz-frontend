<body>

<div id="authModal" class="modal-overlay hidden">
  <div class="modal-box">
    <button class="modal-close" onclick="closeModal()"><i class="fa fa-times"></i></button>
    <div class="modal-tabs">
      <button class="tab-btn active" id="loginTab" onclick="switchTab('login')">Login</button>
      <button class="tab-btn" id="signupTab" onclick="switchTab('signup')">Sign Up</button>
    </div>
    <div id="loginForm" class="auth-form" data-enter-flow>
      <h2>Welcome Back</h2>
      <p class="auth-sub">Sign in to continue</p>
      <div class="auth-google hidden" data-google-slot>
        <div class="google-btn" id="googleLoginBtn"></div>
        <p class="auth-google-note">New to DealBriz? Continuing with Google creates your account, and means you agree to the
          <a href="/terms" onclick="openLegalFromAuth('terms'); return false;">Terms of Service</a> and
          <a href="/privacy" onclick="openLegalFromAuth('privacy'); return false;">Privacy Policy</a>.</p>
        <div class="auth-or"><span>or sign in with email</span></div>
      </div>
      <div class="form-group"><label>Email</label><input type="email" id="loginEmail" placeholder="you@example.com" autocomplete="off"></div>
      <div class="form-group"><label>Password</label><div class="password-wrap"><input type="password" id="loginPassword" autocomplete="current-password" placeholder="••••••••"><button type="button" class="pw-toggle" onclick="togglePassword('loginPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
      <a href="#" class="forgot-link" onclick="openForgotPassword(); return false;">Forgot password?</a>
      <p id="loginError" class="auth-error hidden"></p>
      <button class="btn-primary full-width" data-enter-submit onclick="handleLogin()">Sign In</button>
    </div>
    <div id="signupForm" class="auth-form hidden" data-enter-flow>
      <h2>Create Account</h2>
      <p class="auth-sub">Join DealBriz today</p>
      <div class="auth-google hidden" data-google-slot>
        <div class="google-btn" id="googleSignupBtn"></div>
        <p class="auth-google-note">By continuing with Google you agree to the
          <a href="/terms" onclick="openLegalFromAuth('terms'); return false;">Terms of Service</a> and
          <a href="/privacy" onclick="openLegalFromAuth('privacy'); return false;">Privacy Policy</a>.</p>
        <div class="auth-or"><span>or sign up with email</span></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>First Name</label><input type="text" id="signupFirstName" placeholder="John" autocomplete="off"></div>
        <div class="form-group"><label>Last Name</label><input type="text" id="signupLastName" placeholder="Doe" autocomplete="off"></div>
      </div>
      <div class="form-group"><label>Email</label><input type="email" id="signupEmail" placeholder="you@example.com" autocomplete="off"></div>
      <div class="form-group"><label>Phone</label><input type="tel" id="signupPhone" inputmode="tel" maxlength="17" oninput="sanitisePhone(this)" placeholder="+91 99999 99999" autocomplete="off"></div>
      <div class="form-group"><label>Pincode</label><input type="text" id="signupPincode" placeholder="e.g. 132001" maxlength="6" autocomplete="off"></div>
      <div class="form-group"><label>Password</label><div class="password-wrap"><input type="password" id="signupPassword" autocomplete="new-password" placeholder="Min 8 characters"><button type="button" class="pw-toggle" onclick="togglePassword('signupPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
      <div class="form-group"><label>Confirm Password</label><div class="password-wrap"><input type="password" id="signupConfirmPassword" autocomplete="new-password" placeholder="Re-enter password"><button type="button" class="pw-toggle" onclick="togglePassword('signupConfirmPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
            <div class="signup-terms">
        <input type="checkbox" id="signupTerms">
        <span><label for="signupTerms">I agree to the</label>
          <a href="/terms" onclick="openLegalFromAuth('terms'); return false;">Terms of Service</a> and
          <a href="/privacy" onclick="openLegalFromAuth('privacy'); return false;">Privacy Policy</a>.
        </span>
      </div>
      <p id="signupError" class="auth-error hidden"></p>
      <button class="btn-primary full-width" data-enter-submit onclick="handleSignup()">Create Account</button>
    </div>
        <div id="forgotForm" class="auth-form hidden" data-enter-flow>
      <h2>Reset your password</h2>
      <p class="auth-sub" id="forgotSub">Enter the email you signed up with. We’ll email you a 6-digit code.</p>
      <div id="forgotStep1">
        <div class="form-group"><label for="forgotEmail">Email</label><input type="email" id="forgotEmail" placeholder="you@example.com" autocomplete="email"></div>
      </div>
      <div id="forgotStep2" class="hidden">
        <div class="form-group"><label for="forgotCode">6-digit code</label><input type="text" id="forgotCode" class="forgot-code-input" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" oninput="this.value=this.value.replace(/\D/g,'').slice(0,6); forgotCodeTyped()">
          <div class="forgot-resend-row" id="forgotResendRow"><span>Didn’t get it?</span> <button type="button" id="forgotResend" class="forgot-link-btn forgot-resend" onclick="forgotSendCode(true)" disabled>Resend code</button></div>
          <p id="forgotVerified" class="forgot-verified hidden"><i class="fas fa-circle-check"></i> Code verified</p></div>
        <div id="forgotPwFields" class="hidden">
        <div class="form-group"><label for="forgotNewPassword">New password</label><div class="password-wrap"><input type="password" id="forgotNewPassword" autocomplete="new-password" placeholder="Min 8 characters"><button type="button" class="pw-toggle" onclick="togglePassword('forgotNewPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
        <div class="form-group"><label for="forgotConfirmPassword">Confirm new password</label><div class="password-wrap"><input type="password" id="forgotConfirmPassword" autocomplete="new-password" placeholder="Re-enter new password"><button type="button" class="pw-toggle" onclick="togglePassword('forgotConfirmPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
        </div>
      </div>
      <p id="forgotInfo" class="forgot-info hidden"></p>
      <p id="forgotError" class="auth-error hidden"></p>
      <button id="forgotSubmit" class="btn-primary full-width" data-enter-submit onclick="forgotPrimary()">Send code</button>
      <div class="forgot-actions">
        <button type="button" class="forgot-link-btn" onclick="switchTab('login')">Back to sign in</button>
      </div>
    </div>
  </div>
</div>

<div id="productModal" class="modal-overlay hidden">
  <div class="modal-box product-modal-box">
    <button class="modal-close" onclick="closeProductModal()"><i class="fa fa-times"></i></button>
    <div id="productModalContent"></div>
  </div>
</div>

<div id="chatModal" class="modal-overlay hidden">
  <div class="modal-box chat-modal-box">
    <div class="chat-modal-header">
      <button class="modal-close-inline" onclick="closeChatModal()"><i class="fa fa-arrow-left"></i></button>
      <div class="chat-seller-info">
        <div class="chat-seller-avatar" id="chatSellerAvatar"></div>
        <div class="chat-seller-text">
                    <div class="chat-seller-row">
            <div class="chat-seller-name" id="chatSellerName">Seller</div>
            <button class="chat-info-btn" onclick="showChatPartyInfo()" title="About this person" aria-label="About this person">
              <i class="fas fa-circle-info"></i>
            </button>
            <button class="chat-view-listing hidden" id="chatViewListing"
                    onclick="openChatListing()" title="Open this listing">
              <i class="fas fa-box-open"></i> View listing
            </button>
          </div>
          <div class="chat-product-title" id="chatProductTitle"></div>
        </div>
      </div>
      <button class="chat-close-btn" onclick="closeChatModal()" title="Close chat" aria-label="Close chat">
        <i class="fas fa-xmark"></i>
      </button>
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="chat-notice"><i class="fas fa-shield-alt"></i> All chats are monitored for your safety. Never share OTPs or payment outside DealBriz.</div>
    </div>
    <div class="chat-input-area">
            <div class="chat-deal-bar hidden" id="chatDealBar"></div>
            <div class="chat-quick-msgs" id="chatQuickMsgs"></div>
      <div class="chat-input-row">
        <input type="text" id="chatInput" placeholder="Type a message..." onkeydown="if(event.key==='Enter') sendMessage()" autocomplete="off">
        <button class="chat-send-btn" onclick="sendMessage()"><i class="fas fa-paper-plane"></i></button>
      </div>
    </div>
  </div>
</div>

<div id="imageLightbox" class="modal-overlay lightbox hidden">
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close image"><i class="fas fa-xmark"></i></button>
  <button class="lightbox-nav lightbox-prev hidden" onclick="lightboxNav(-1)" aria-label="Previous image"><i class="fas fa-chevron-left"></i></button>
  <img id="lightboxImg" src="" alt="">
  <button class="lightbox-nav lightbox-next hidden" onclick="lightboxNav(1)" aria-label="Next image"><i class="fas fa-chevron-right"></i></button>
  <div class="lightbox-count hidden" id="lightboxCount"></div>
</div>

<div id="emiModal" class="modal-overlay hidden">
  <div class="modal-box emi-modal-box">
    <button class="modal-close" onclick="closeEmiModal()"><i class="fa fa-times"></i></button>
    <div class="emi-header">
      <div class="emi-icon"><i class="fas fa-hand-holding-usd"></i></div>
      <h2>Apply for EMI</h2>
      <p>Flexible financing for your purchase</p>
    </div>
    <div id="emiProductName" class="emi-product-label"></div>
    <div class="emi-calculator">
      <div class="emi-price-display">
        <span class="emi-label">Product Price</span>
        <span id="emiPrice" class="emi-amount">₹0</span>
      </div>
      <div class="form-group"><label>Down Payment (₹)</label><input type="number" id="downPayment" placeholder="e.g. 5000" oninput="calcEMI()" autocomplete="off"></div>
      <div class="form-group"><label>Tenure</label>
        <select id="emiTenure" onchange="calcEMI()">
          <option value="3">3 Months</option><option value="6" selected>6 Months</option>
          <option value="12">12 Months</option><option value="18">18 Months</option>
          <option value="24">24 Months</option><option value="36">36 Months</option>
        </select>
      </div>
      <div class="form-group"><label>Interest Rate</label>
        <select id="emiRate" onchange="calcEMI()">
          <option value="12">12% – Standard</option><option value="10">10% – Good Credit</option>
          <option value="8">8% – Excellent Credit</option><option value="15">15% – No Credit Check</option>
        </select>
      </div>
      <div class="emi-result">
        <div class="emi-result-item"><span>Loan Amount</span><strong id="loanAmt">₹0</strong></div>
        <div class="emi-result-item"><span>Monthly EMI</span><strong id="monthlyEmi" class="highlight">₹0</strong></div>
        <div class="emi-result-item"><span>Total Payable</span><strong id="totalPay">₹0</strong></div>
        <div class="emi-result-item"><span>Total Interest</span><strong id="totalInt">₹0</strong></div>
      </div>
    </div>
    <div class="form-group"><label>Full Name</label><input type="text" id="emiFullName" placeholder="As per Aadhaar" autocomplete="off"></div>
    <div class="form-group"><label>Phone</label><input type="tel" id="emiPhone" inputmode="tel" maxlength="17" oninput="sanitisePhone(this)" placeholder="+91 99999 99999" autocomplete="off"></div>
    <div class="form-group"><label>Monthly Income (₹)</label><input type="number" id="emiIncome" placeholder="e.g. 25000" autocomplete="off"></div>
    <p id="emiFormMsg" class="auth-error hidden"></p>
    <div class="emi-note"><i class="fas fa-info-circle"></i><span>Our loan partner pays the seller directly. You repay in monthly EMIs.</span></div>
    <button class="btn-primary full-width" onclick="submitEMI()">Submit EMI Application</button>
  </div>
</div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="dbBlueGrad" x1="68" y1="36" x2="68" y2="144" gradientUnits="userSpaceOnUse">
      <stop stop-color="#2563EB"/><stop offset="1" stop-color="#1A56DB"/>
    </linearGradient>
    <linearGradient id="dbOrangeGrad" x1="44" y1="58" x2="136" y2="122" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FF7A1A"/><stop offset="1" stop-color="#F95A00"/>
    </linearGradient>
    <filter id="dbSoftShadow" x="32" y="52" width="116" height="84" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#0B1B3D" flood-opacity="0.16"/>
    </filter>
    <g id="dbBridgeMark" transform="translate(0 0)">
            <rect x="68" y="36" width="22" height="108" rx="11" fill="url(#dbBlueGrad)"/>
            <g filter="url(#dbSoftShadow)">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M55 58C48.9249 58 44 62.9249 44 69C44 75.0751 48.9249 80 55 80H90C101.046 80 110 88.9543 110 100C110 111.046 101.046 120 90 120H55C48.9249 120 44 124.925 44 131C44 137.075 48.9249 142 55 142H90C113.196 142 132 123.196 132 100C132 76.804 113.196 58 90 58H55Z" fill="url(#dbOrangeGrad)"/>
      </g>
    </g>
  </defs>
</svg>

<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand" onclick="showPage('home'); return false;">
      <img class="brand-logo" src="/logo-full.png" alt="DealBriz" height="38">
    </a>
    <div class="nav-desktop">
      <button class="nav-loc" onclick="openLocationPicker()">
        <i class="fas fa-location-dot"></i> <span data-area-label>Chandigarh</span> <i class="fas fa-chevron-down"></i>
      </button>
      <div class="nav-buy-search" id="navBuySearch">
        <i class="fas fa-search"></i>
        <input type="text" id="buySearchInput" placeholder="Try: bike under 60k above 2015" autocomplete="off"
               oninput="onSearchInput('buySearchInput','buySuggest')"
               onkeydown="handleSearchKeys(event,'buySearchInput','buySuggest',triggerBuySearch)">
        <div id="buySuggest" class="search-suggest hidden"></div>
        <button onclick="triggerBuySearch()" class="nav-buy-search-go">Go</button>
      </div>
    </div>
        <div class="nav-desktop-links">
      <a href="/sell" class="nav-cta-sell" data-nav="sell" onclick="startSell(); return false;"><i class="fas fa-plus"></i> Post Ad / Sell</a>
      <a href="/buy" data-nav="buy" onclick="showPage('buy'); return false;">Explore Deals</a>
      <a href="/#map" class="nav-live-map" onclick="showPage('home'); setTimeout(()=>document.getElementById('hbHeroMap')?.scrollIntoView({behavior:'smooth',block:'center'}),300); return false;"><span class="nav-live-dot"></span> Live Map</a>
      <a href="/#how-it-works" onclick="goHowItWorks(); return false;">Why DealBriz</a>
    </div>
    <div class="nav-actions">
            <button class="nav-icon-btn nav-badge-btn nav-chat-glow" id="navChatBtn" onclick="openChatsFromNav()"
              aria-label="Chats" title="Chats">
        <svg class="nav-chat-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 7a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-3l-4 4.5L9 19H8a3 3 0 0 1-3-3V7z" fill="url(#chatGrad)"/>
          <circle cx="10" cy="11.5" r="1.3" fill="#fff"/>
          <circle cx="14" cy="11.5" r="1.3" fill="#fff"/>
          <circle cx="18" cy="11.5" r="1.3" fill="#fff"/>
          <defs><linearGradient id="chatGrad" x1="5" y1="4" x2="23" y2="23" gradientUnits="userSpaceOnUse">
            <stop stop-color="#1A56DB"/><stop offset="1" stop-color="#1346B8"/>
          </linearGradient></defs>
        </svg>
        <span class="nav-dot hidden" id="navChatDot"></span>
      </button>
      <button class="nav-icon-btn nav-badge-btn" id="navNotifBtn" onclick="toggleNotifPanel()"
              aria-label="Notifications" title="Notifications">
        <i class="fas fa-bell"></i>
        <span class="nav-dot hidden" id="navNotifDot"></span>
      </button>
            <button class="nav-signin-btn" id="loginNavBtn" onclick="openModal()"><i class="fas fa-user"></i> <span>Sign in</span></button>
      <div class="user-avatar hidden" id="userAvatar" onclick="toggleUserMenu()">
        <img src="" alt="User" id="userAvatarImg">
        <span class="staff-badge hidden" id="navStaffBadge" title="Staff account"><i class="fas fa-crown"></i></span>
      </div>
      <div class="user-menu hidden" id="userMenu">
        <div class="user-menu-header">
          <img src="" id="userMenuAvatar" alt="">
          <div>
            <strong id="userMenuName"></strong>
            <small id="userMenuEmail"></small>
            <div id="userMenuRoleBadges" class="role-badges"></div>
          </div>
        </div>
        <hr>
        <a href="/profile" onclick="showPage('profile'); return false;"><i class="fas fa-user-circle"></i> My Profile</a>
        <a href="/mydeals" onclick="showPage('mydeals'); return false;"><i class="fas fa-handshake"></i> My Deals</a>
        <a href="/mylistings" onclick="showPage('mylistings'); return false;"><i class="fas fa-list"></i> My Listings</a>
        <a href="/myads" onclick="showPage('myads'); return false;"><i class="fas fa-heart"></i> Saved Items</a>
        <a href="/emi-status" class="emi-feature emi-status-link" onclick="showPage('emi-status'); return false;"><i class="fas fa-file-invoice-dollar"></i> EMI Status</a>
        <a href="/mychats" onclick="showPage('mychats'); return false;"><i class="fas fa-comments"></i> My Chats</a>
        <div id="userMenuAdminLink" class="hidden">
          <hr>
          <a href="/admin" onclick="openAdminPanel(); return false;" class="staff-link"><i class="fas fa-shield-alt"></i> Admin Panel</a>
        </div>
        <hr>
        <a href="/logout" onclick="handleLogout(); return false;" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>

            <div class="notif-panel hidden" id="notifPanel">
        <div class="notif-panel-head">
          <strong>Notifications</strong>
          <button type="button" id="notifMarkAllBtn" onclick="markAllNotificationsRead()">Mark all read</button>
        </div>
        <div class="notif-list" id="notifList"></div>
      </div>
    </div>
  </div>
</nav>

<div id="homePage" class="page">

    <section class="hb-hero">
    <div class="hb-wrap hb-hero-grid">
      <div class="hb-hero-copy">
        <div class="hb-badge"><i class="fas fa-star"></i> India's 1st Peer-to-Peer Marketplace with Instant EMI</div>
        <h1>Great Deals<br><span class="hb-accent">Easy EMIs.</span></h1>
        <p class="hb-lede">Buy smartphones, laptops, cars, and designer furniture directly from verified owners with zero-paperwork monthly installments.</p>

        <div class="hb-hero-btns">
          <button class="hb-btn hb-btn-primary" onclick="showPage('buy')">Browse Products <i class="fas fa-arrow-right"></i></button>
          <button class="hb-btn hb-btn-amber" onclick="startSell()"><i class="fas fa-plus"></i> Sell Your Item</button>
        </div>

        <div class="hb-hero-search">
          <button class="hb-hero-loc" onclick="openLocationPicker()">
            <i class="fas fa-location-dot"></i> <span data-area-label>Chandigarh</span> <i class="fas fa-chevron-down"></i>
          </button>
          <input type="text" id="homeSearchInput" placeholder="Try: iphone 12 grey under 30000" autocomplete="off"
                 oninput="onSearchInput('homeSearchInput','homeSuggest')"
                 onkeydown="handleSearchKeys(event,'homeSearchInput','homeSuggest',homeSearch)">
          <div id="homeSuggest" class="search-suggest hidden"></div>
          <button class="hb-go" onclick="homeSearch()" aria-label="Search"><i class="fas fa-search"></i></button>
        </div>

        <div class="hb-stats">
          <div class="hb-stat"><strong id="statListings">0</strong><span>Active Listings</span></div>
          <div class="hb-stat-div"></div>
          <div class="hb-stat amber emi-feature"><strong><i class="fas fa-bolt"></i></strong><span>EMI Available</span></div>
          <div class="hb-stat-div"></div>
          <div class="hb-stat"><strong>100%</strong><span>Secure Chat</span></div>
        </div>
      </div>
    </div>

        <div class="hb-hero-map" id="hbHeroMap">
      <div id="homeMap" class="hb-map-canvas">
                <div class="hb-map-fade" aria-hidden="true"></div>
      </div>

      <div class="hb-map-zoom">
        <button type="button" onclick="homeMapZoom(1)" aria-label="Zoom in"><i class="fas fa-plus"></i></button>
        <button type="button" onclick="homeMapZoom(-1)" aria-label="Zoom out"><i class="fas fa-minus"></i></button>
        <span class="hb-map-zoom-sep"></span>
        <button type="button" onclick="recenterHomeMap()" aria-label="Recenter on my area"><i class="fas fa-location-crosshairs"></i></button>
      </div>

      <div class="hb-map-status">
        <span class="hb-map-dot"></span>
        <span id="homeMapChipText">Loading listings…</span>
        <button type="button" class="hb-map-browse" onclick="showPage('buy')">Browse all <i class="fas fa-arrow-right"></i></button>
      </div>

      <a class="hb-map-credit" href="https://www.openstreetmap.org/copyright"
         target="_blank" rel="noopener noreferrer">&copy; OpenStreetMap contributors &middot; tiles: OSM France</a>

