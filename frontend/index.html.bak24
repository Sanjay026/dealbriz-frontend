        <li><button class="dbz-tile dbz-tile--blue" type="button" data-slug="furniture" data-name="Furniture" data-count="" aria-label="Browse Furniture" aria-haspopup="dialog" style="--i:8"><span class="dbz-tile__icon"><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="24" y="34" width="72" height="30" rx="10"/><path d="M60 34V28"/><rect x="30" y="64" width="60" height="12" rx="4"/><rect x="14" y="44" width="14" height="32" rx="6"/><rect x="92" y="44" width="14" height="32" rx="6"/><path d="M34 76v14M86 76v14"/></svg></span><span class="dbz-tile__name">Furniture</span></button></li>
        <li><button class="dbz-tile dbz-tile--white" type="button" data-slug="others" data-name="Others" data-count="" aria-label="Browse Others" aria-haspopup="dialog" style="--i:9"><span class="dbz-tile__icon"><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="20" y="28" width="40" height="32" rx="6"/><circle cx="82" cy="44" r="18"/><rect x="20" y="68" width="80" height="28" rx="6"/><path d="M50 68v28"/><circle cx="40" cy="44" r="4"/></svg></span><span class="dbz-tile__name">Others</span></button></li>
          </ul>

          <div class="dbz-panel" role="dialog" aria-label="Category preview" aria-hidden="true" inert>
            <div class="dbz-panel__content">
              <span class="dbz-panel__eyebrow">Category</span>
              <h3 class="dbz-panel__name" data-panel-name></h3>
              <p class="dbz-panel__count" data-panel-countrow hidden><strong data-panel-count>0</strong> <span data-panel-countword>listings</span></p>
              <button class="dbz-panel__cta" type="button" data-panel-cta>
                <span data-panel-cta-label>Browse</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
              <span class="dbz-panel__hint">Move away to see all categories</span>
            </div>
            <div class="dbz-panel__art" data-panel-art></div>
            <button class="dbz-panel__close" type="button" aria-label="Close and show all categories">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

    <section class="hb-section hb-section--how" id="howItWorks">
    <div class="hb-wrap">
      <div class="dbz-how" data-dbz-how>
        <div class="hb-head-center hb-reveal">
          <h2>How DealBriz Works</h2>
          <div class="dbz-how__toggle" role="group" aria-label="Show steps for">
            <button type="button" data-flow="buy" aria-pressed="true">Buying</button>
            <button type="button" data-flow="sell" aria-pressed="false">Selling</button>
          </div>
        </div>
        <div class="dbz-how__track">
          <svg class="dbz-how__road" aria-hidden="true" focusable="false"></svg>
          <ol class="dbz-how__steps"></ol>
          <div class="dbz-how__finish" aria-hidden="true"></div>
        </div>
        <div class="dbz-how__cta hb-reveal">
          <button class="hb-btn hb-btn-primary" onclick="showPage('buy')">Start exploring <i class="fas fa-arrow-right"></i></button>
        </div>
      </div>
    </div>
  </section>

    <section class="hb-superpowers">
    <div class="hb-wrap">
      <div class="hb-sp-header hb-reveal">
        <span class="hb-sp-badge">⚡ The DealBriz Difference</span>
        <h2>Buy & Sell with Complete Confidence</h2>
        <p>Why 50,000+ Indians switched from chaotic classifieds to DealBriz.</p>
      </div>

      <div class="hb-sp-grid">
                <div class="hb-sp-card hb-reveal">
          <div class="hb-sp-illus">
            <svg width="220" height="160" viewBox="0 0 220 160" fill="none">
              <circle cx="110" cy="80" r="65" fill="#EFF6FF"/>
