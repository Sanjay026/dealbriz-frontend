        <li><button class="dbz-tile dbz-tile--blue" type="button" data-slug="mobiles" data-name="Mobiles" data-count="" aria-label="Browse Mobiles" aria-haspopup="dialog" style="--i:4"><span class="dbz-tile__icon"><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="30" y="14" width="60" height="92" rx="12"/><path d="M52 24h16"/><circle cx="60" cy="90" r="4"/><rect x="38" y="34" width="44" height="46" rx="4"/></svg></span><span class="dbz-tile__name">Mobiles</span></button></li>
