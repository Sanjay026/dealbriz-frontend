          <div class="hb-sp-meta">
            <span class="hb-sp-step hb-sp-step--blue">Step 03 · Privacy</span>
            <span class="hb-sp-tag hb-sp-tag--slate">No Spam Calls</span>
          </div>
          <h3>Escrow Protected Chat</h3>
          <p>No unsolicited WhatsApp messages or fraud callers. Both buyer and seller are Aadhaar-verified, and negotiations stay encrypted.</p>
        </div>
      </div>
    </div>
  </section>

    <section class="hb-sell">
    <div class="hb-wrap hb-sell-grid">
      <div class="hb-reveal">
        <h2>Turn Your Unused Things<span>Into Cash.</span></h2>
        <p>List your product for free and reach thousands of buyers near you.</p>
        <div class="hb-sell-btns">
          <button class="hb-btn hb-btn-amber" onclick="startSell()"><i class="fas fa-plus"></i> List Your Item — It's Free</button>
          <button class="hb-link-btn" onclick="goHowSellingWorks()">Learn How Selling Works <i class="fas fa-arrow-right"></i></button>
        </div>
      </div>

      <div class="hb-sell-card hb-reveal">
        <div class="hb-sell-card-head">
          <strong><i class="fas fa-box-open"></i> Listing in 3 steps</strong>
          <span class="hb-live">FREE</span>
        </div>
        <div class="hb-mini">
          <div class="hb-mini-row">
            <div class="hb-mini-n">1</div>
            <div><strong>Add photos &amp; details</strong><span>Up to 5 photos, condition and price.</span></div>
          </div>
          <div class="hb-mini-row">
            <div class="hb-mini-n">2</div>
            <div><strong>Set your location</strong><span>Buyers nearby find you first.</span></div>
          </div>
          <div class="hb-mini-row">
            <div class="hb-mini-n">3</div>
            <div><strong>Publish and reply</strong><span>Answer buyers in secure in-app chat.</span></div>
          </div>
        </div>
        <div class="hb-sell-card-foot"><i class="fas fa-circle-check"></i> No listing fee, no commission to post</div>
      </div>
    </div>
  </section>

</div>

<div id="buyPage" class="page hidden">
  <div class="buy-header">
    <button class="back-btn" onclick="goBack()"><i class="fas fa-arrow-left"></i></button>
    <div class="cat-scroll">
    <button class="cat-pill active" data-cat="all" onclick="setCat(this,'all')">All</button>
    <button class="cat-pill" data-cat="cars" onclick="setCat(this,'cars')"><i class="fas fa-car-side"></i> Cars</button>
    <button class="cat-pill" data-cat="phones" onclick="setCat(this,'phones')"><i class="fas fa-mobile-screen-button"></i> Phones</button>
    <button class="cat-pill" data-cat="bikes" onclick="setCat(this,'bikes')"><i class="fas fa-motorcycle"></i> Bikes</button>
    <button class="cat-pill" data-cat="electronics" onclick="setCat(this,'electronics')"><i class="fas fa-laptop"></i> Electronics</button>
    <button class="cat-pill" data-cat="furniture" onclick="setCat(this,'furniture')"><i class="fas fa-couch"></i> Furniture</button>
    <button class="cat-pill" data-cat="appliances" onclick="setCat(this,'appliances')"><i class="fas fa-blender"></i> Appliances</button>
    <button class="cat-pill" data-cat="fashion" onclick="setCat(this,'fashion')"><i class="fas fa-shirt"></i> Fashion</button>
    <button class="cat-pill" data-cat="property" onclick="setCat(this,'property')"><i class="fas fa-building"></i> Property</button>
    <button class="cat-pill" data-cat="others" onclick="setCat(this,'others')"><i class="fas fa-box-open"></i> Others</button>
    </div>
  </div>

    <div class="filter-bar">
    <button class="filter-toggle-btn" onclick="toggleFilters()"><i class="fas fa-sliders-h"></i> Filters</button>
        <button class="filter-clear-btn hidden" id="clearFiltersBtn" onclick="clearBuyFilters()"><i class="fas fa-xmark"></i> Clear</button>
    <div class="filter-chips" id="activeFilterChips"></div>
    <select class="sort-select" id="buySortSelect" onchange="applyBuyFilters()">
      <option value="recommended" selected>Recommended</option>
      <option value="newest">Newest</option>
      <option value="price_asc">Price ↑</option>
      <option value="price_desc">Price ↓</option>
    </select>
  </div>

    <div class="filter-panel hidden" id="filterPanel">
    <div class="filter-panel-inner">
      <div class="filter-group">
        <label>Price Range</label>
        <div class="price-inputs">
          <input type="number" id="priceMin" placeholder="Min ₹" min="0" oninput="clampNonNegative(this); applyBuyFilters()" autocomplete="off">
          <span>–</span>
          <input type="number" id="priceMax" placeholder="Max ₹" min="0" oninput="clampNonNegative(this); applyBuyFilters()" autocomplete="off">
        </div>
      </div>
      <div class="filter-group">
        <label>Pincode</label>
        <input type="text" id="pincodeFilter" placeholder="e.g. 132001" maxlength="6" oninput="applyBuyFilters()" autocomplete="off">
      </div>
      <div class="filter-group emi-feature">
        <label>EMI Available</label>
        <label class="toggle-label"><input type="checkbox" id="emiFilter" onchange="applyBuyFilters()"> Show EMI eligible only</label>
      </div>
    </div>
  </div>

  <div id="searchUnderstood" class="search-understood hidden"></div>
  <div class="buy-results-count" id="buyResultsCount"></div>
  <div class="listings-grid" id="buyListingsGrid"></div>
  <div id="buyNoResults" class="no-results hidden">
    <i class="fas fa-search"></i>
    <h3>No listings found</h3>
    <p>Try adjusting your search or filters</p>
    <button class="btn-primary" onclick="clearBuyFilters()">Clear Filters</button>
  </div>
  <div class="buy-loading hidden" id="buyLoading">
    <i class="fas fa-spinner fa-spin"></i> Loading...
  </div>
  <div id="buyPager" class="admin-pager buy-pager"></div>
</div>

<div id="sellPage" class="page hidden">
  <div class="page-header">
    <button class="back-btn" onclick="goBack()"><i class="fas fa-arrow-left"></i></button>
    <h2 id="sellPageTitle">Post Your Ad</h2>
  </div>
  <div class="sell-form-wrap" data-enter-flow>

        <div class="sell-section">
      <h3><span class="sell-step">1</span> Add Photos</h3>
      <p class="sell-hint">First photo will be the cover. Max 5 photos.</p>
      <div class="photo-upload-area" id="photoUploadArea">
        <input type="file" id="photoInput" accept="image/*" multiple onchange="handlePhotoUpload(event)" style="display:none">
        <div class="photo-grid" id="photoGrid">
          <div class="photo-add-btn" onclick="document.getElementById('photoInput').click()">
            <i class="fas fa-camera"></i>
            <span>Add Photos</span>
          </div>
        </div>
      </div>
    </div>

        <div class="sell-section">
      <h3><span class="sell-step">2</span> Category</h3>
      <div class="sell-cat-grid" id="sellCatGrid">
        <div class="sell-cat-item" data-cat="cars" onclick="selectSellCat(this,'cars')"><i class="fas fa-car"></i><span>Cars</span></div>
        <div class="sell-cat-item" data-cat="phones" onclick="selectSellCat(this,'phones')"><i class="fas fa-mobile-alt"></i><span>Phones</span></div>
        <div class="sell-cat-item" data-cat="bikes" onclick="selectSellCat(this,'bikes')"><i class="fas fa-motorcycle"></i><span>Bikes</span></div>
        <div class="sell-cat-item" data-cat="electronics" onclick="selectSellCat(this,'electronics')"><i class="fas fa-laptop"></i><span>Electronics</span></div>
        <div class="sell-cat-item" data-cat="furniture" onclick="selectSellCat(this,'furniture')"><i class="fas fa-couch"></i><span>Furniture</span></div>
        <div class="sell-cat-item" data-cat="appliances" onclick="selectSellCat(this,'appliances')"><i class="fas fa-blender"></i><span>Appliances</span></div>
        <div class="sell-cat-item" data-cat="fashion" onclick="selectSellCat(this,'fashion')"><i class="fas fa-tshirt"></i><span>Fashion</span></div>
        <div class="sell-cat-item" data-cat="property" onclick="selectSellCat(this,'property')"><i class="fas fa-home"></i><span>Property</span></div>
        <div class="sell-cat-item" data-cat="others" onclick="selectSellCat(this,'others')"><i class="fas fa-box-open"></i><span>Others</span></div>
      </div>
            <label class="toggle-label emi-feature sell-emi-toggle"><input type="checkbox" id="sellEmiEligible" checked onchange="if (typeof sellDocsRender === 'function') sellDocsRender()">
        <span><strong>Offer EMI option</strong><small>Buyers can pay in monthly instalments through DealBriz’s lending partners.</small></span></label>
    </div>

        <div class="sell-section hidden" id="sellDocs">
      <h3><span class="sell-step"><i class="fas fa-file-shield"></i></span> Vehicle documents</h3>
      <div id="sellDocsBody"></div>
    </div>

        <div class="sell-section">
      <h3><span class="sell-step">3</span> Item Details</h3>
      <div class="form-group"><label>Title <span class="req">*</span></label><input type="text" id="sellTitle" placeholder="e.g. Honda City 2021 – Single Owner" maxlength="80" autocomplete="off"></div>
      <div class="form-group"><label>Description <span class="req">*</span></label>
        <textarea id="sellDesc" rows="5" placeholder="Describe your item — condition, age, reason for selling, any defects. Be honest for faster sale."></textarea>
      </div>
      <div class="form-group"><label>Condition <span class="req">*</span></label>
        <select id="sellCondition">
          <option value="">Select condition</option>
          <option value="like_new">Like New</option>
          <option value="good">Good</option>
          <option value="fair">Fair</option>
          <option value="for_parts">For Parts / Not Working</option>
        </select>
      </div>
            <div class="form-group combo-group">
        <label id="sellBrandLabel">Brand / Make</label>
        <input type="text" id="sellBrand" placeholder="e.g. Samsung, Honda, IKEA" autocomplete="off"
               onfocus="openComboMenu('sellBrand')" onclick="openComboMenu('sellBrand')"
               oninput="filterComboMenu('sellBrand')">
        <div class="combo-menu hidden" id="sellBrand_menu"></div>
      </div>
            <div class="form-group"><label id="sellModelLabel">Model</label><input type="text" id="sellModel" placeholder="e.g. Figo Aspire, Galaxy S21" autocomplete="off"></div>

            <div id="sellAttributes" class="sell-attrs"></div>
    </div>

        <div class="sell-section">
      <h3><span class="sell-step">4</span> Set Your Price</h3>
      <div class="form-group"><label>Price (₹) <span class="req">*</span></label>
        <div class="price-input-wrap">
          <span class="price-prefix">₹</span>
                    <input type="number" id="sellPrice" placeholder="0" min="0" step="1" inputmode="numeric" autocomplete="off" oninput="clampNonNegative(this)">
        </div>
      </div>
      <label class="toggle-label"><input type="checkbox" id="sellNegotiable"> Price is negotiable</label>
      <label class="toggle-label" style="margin-top:10px"><input type="checkbox" id="sellFeature"> <i class="fas fa-bolt" style="color:var(--gold)"></i> Show at top for 7 days <small style="color:var(--text-light)">(free while in beta)</small></label>
    </div>

        <div class="sell-section">
      <h3><span class="sell-step">5</span> Location</h3>
      <div class="form-group"><label>Pincode <span class="req">*</span></label>
        <input type="text" id="sellPincode" placeholder="e.g. 132001" maxlength="6" oninput="lookupPincode(this.value)" autocomplete="off">
        <small id="pincodeResult" class="pincode-result"></small>
      </div>
      <div class="form-group"><label>Exact Location / Landmark</label>
        <input type="text" id="sellLandmark" placeholder="e.g. Near Sector 7 Market" autocomplete="off">
      </div>
    </div>

        <div class="sell-section">
      <h3><span class="sell-step">6</span> Contact Preference</h3>
      <div class="form-group"><label>Show phone number to buyers?</label>
        <select id="sellShowPhone">
          <option value="yes">Yes, show my number</option>
          <option value="chat_only">No, chat only</option>
        </select>
      </div>
    </div>

    <div id="sellError" class="auth-error hidden"></div>
    <button class="btn-primary full-width sell-submit-btn" data-enter-submit onclick="handleSellSubmit()">
      <i class="fas fa-upload"></i> Save & Post Ad
    </button>
    <p class="sell-note">By posting, you agree to our <a href="/terms" data-foot="legal:terms" onclick="openLegalPage('terms'); return false;">Terms of Service</a>. Your ad will be visible immediately.</p>
  </div>
</div>

