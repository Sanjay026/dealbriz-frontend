</div>

<div id="dealOfferModal" class="modal-overlay hidden">
  <div class="modal-box deal-modal-box deal-offer-box">
    <button class="modal-close" onclick="closeOfferComposer()" aria-label="Close"><i class="fas fa-xmark"></i></button>
    <h3 id="dealOfferTitle" class="deal-modal-title">Send a deal offer</h3>
    <p id="dealOfferSub" class="deal-modal-sub"></p>
    <div class="form-group">
      <label for="dealOfferPrice">Price (₹)</label>
      <input data-rupee type="text" id="dealOfferPrice" class="deal-price-input" inputmode="numeric" autocomplete="off" oninput="dlFormatRupeeInput(this)" onkeydown="if(event.key==='Enter') submitOfferComposer()">
    </div>
    <div class="form-group">
      <label for="dealOfferNote">Note <span class="deal-optional">optional</span></label>
      <textarea id="dealOfferNote" rows="2" maxlength="500" placeholder="e.g. Price includes new tyres"></textarea>
    </div>
        <div id="dealOfferWrap" class="deal-offer-mode">
      <label class="deal-offer-mode-row" for="dealOfferDeallock">
        <input type="checkbox" id="dealOfferDeallock" onchange="dlOfferModeChanged()">
        <span><strong id="dealOfferModeTitle">Buy with EMI (DealLock)</strong><small id="dealOfferModeHint"></small></span>
      </label>
      <p id="dealOfferModeOff" class="deal-offer-mode-off hidden"></p>
    </div>
    <p id="dealOfferInfo" class="deal-small"></p>
    <p id="dealOfferError" class="auth-error hidden"></p>
    <button id="dealOfferSubmit" class="btn-primary full-width" onclick="submitOfferComposer()">Send offer</button>
  </div>
</div>

<div id="dealModal" class="modal-overlay hidden">
  <div class="modal-box deal-modal-box">
    <button class="modal-close" onclick="closeTopModal('deal')" aria-label="Close"><i class="fas fa-xmark"></i></button>
    <div id="dealModalBody"></div>
  </div>
</div>

<div id="dealLoanModal" class="modal-overlay hidden">
  <div class="modal-box deal-modal-box">
    <button class="modal-close" onclick="closeLoanForm()" aria-label="Close"><i class="fas fa-xmark"></i></button>
        <div id="dealLoanDone" class="hidden"></div>
    <div id="dealLoanFormArea">
    <h3 class="deal-modal-title">Apply for the loan</h3>
    <p class="deal-modal-sub">Agreed price <strong id="dealLoanPrice"></strong> <span id="dealLoanType"></span></p>
        <div class="form-group deal-loan-lender">
      <label for="dealLoanLender">Choose your lender</label>
      <select id="dealLoanLender" onchange="dlLoanLenderChanged()"><option value="">Loading lenders...</option></select>
      <small id="dealLoanLenderHint" class="deal-loan-lender-hint">Your application and verified documents are sent only to the lender you choose.</small>
    </div>
    <div id="dealLoanExisting"></div>
    <div class="form-group">
      <label for="dealLoanDown">Down payment (₹)</label>
      <input data-rupee type="text" id="dealLoanDown" inputmode="numeric" placeholder="e.g. 50,000" autocomplete="off" oninput="dlFormatRupeeInput(this); calcDealLoan()">
    </div>
    <div class="form-row">
      <div class="form-group"><label for="dealLoanTenure">Tenure</label>
        <select id="dealLoanTenure" onchange="calcDealLoan()">
          <option value="12">12 months</option><option value="18">18 months</option>
          <option value="24">24 months</option><option value="36" selected>36 months</option>
          <option value="48">48 months</option><option value="60">60 months</option>
        </select>
      </div>
      <div class="form-group"><label>Interest (estimate)</label>
                <div id="dealLoanRate" class="deal-loan-rate-fixed">10–16% p.a.</div>
      </div>
    </div>
    <div class="deal-loan-result">
      <div><span>Loan</span><strong id="dealLoanAmount">₹0</strong></div>
      <div><span>EMI / month</span><strong id="dealLoanEmi">₹0</strong></div>
      <div><span>Total repayable</span><strong id="dealLoanTotal">₹0</strong></div>
    </div>
    <div class="deal-loan-assume" role="note"><i class="fas fa-circle-exclamation" aria-hidden="true"></i><div><strong>Please note: these figures are estimates</strong><span>The interest rate is shown as a 10–16% range and the EMI and totals are worked out on it. The NBFC you choose will contact you about the actual rate, EMI and other details, and confirms them in its Key Fact Statement before you sign anything.</span></div></div>
    <div class="form-group"><label for="dealLoanName">Full name</label><input type="text" id="dealLoanName" placeholder="As per Aadhaar" autocomplete="off"></div>
    <div class="form-row">
      <div class="form-group"><label for="dealLoanPhone">Phone</label><input type="tel" id="dealLoanPhone" inputmode="tel" maxlength="17" autocomplete="off"></div>
      <div class="form-group"><label for="dealLoanIncome">Monthly income (₹)</label><input data-rupee type="text" id="dealLoanIncome" inputmode="numeric" placeholder="e.g. 40,000" autocomplete="off" oninput="dlFormatRupeeInput(this)"></div>
    </div>
    <p id="dealLoanError" class="auth-error hidden"></p>
    <button class="btn-primary full-width" onclick="submitDealLoan()">Send application</button>
    </div>
  </div>
</div>

<div id="dealOtpModal" class="modal-overlay hidden">
  <div class="modal-box deal-modal-box deal-otp-box">
    <button class="modal-close" onclick="closeTopModal('dealOtp')" aria-label="Close"><i class="fas fa-xmark"></i></button>
    <h3 class="deal-modal-title"><i class="fas fa-shield-halved"></i> <span id="dealOtpTitle">Confirm with the SMS code</span></h3>
    <p id="dealOtpSub" class="deal-modal-sub"></p>
        <input id="dealOtpPassword" aria-label="Your DealBriz password" class="deal-otp-input deal-otp-password hidden" type="password" autocomplete="current-password" placeholder="Your password"
           onkeydown="if(event.key==='Enter') dlOtpSubmit()">
    <input id="dealOtpCode" aria-label="6-digit code" class="deal-otp-input" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000"
           oninput="this.value=this.value.replace(/\D/g,'').slice(0,6)" onkeydown="if(event.key==='Enter') dlOtpSubmit()">
    <p id="dealOtpError" class="auth-error hidden"></p>
    <button id="dealOtpSubmit" class="btn-primary full-width" onclick="dlOtpSubmit()">Confirm and lock the deal</button>
    <button id="dealOtpResend" class="deal-btn deal-btn-quiet deal-btn-wide" onclick="dlOtpSend()">Send the code again</button>
  </div>
</div>

<div id="dealWarnModal" class="modal-overlay hidden">
  <div class="modal-box deal-warn-box" role="alertdialog" aria-modal="true" aria-labelledby="dealWarnTitle">
    <div class="deal-warn-icon"><i class="fas fa-triangle-exclamation"></i></div>
    <h3 id="dealWarnTitle" class="deal-warn-title"></h3>
    <div id="dealWarnBody" class="deal-warn-body"></div>
    <label class="deal-warn-check">
      <input type="checkbox" id="dealWarnCheck" onchange="dlWarnToggle()">
      <span>I have read this and I understand.<br><span lang="hi">मैंने इसे पढ़ लिया है और मैं समझता/समझती हूँ।</span></span>
    </label>
    <div class="deal-warn-actions">
      <button class="deal-btn" onclick="dlWarnAnswer(false)">Go back <span lang="hi">/ वापस</span></button>
      <button id="dealWarnGo" class="deal-btn deal-btn-primary" disabled onclick="dlWarnAnswer(true)">Continue <span lang="hi">/ आगे बढ़ें</span></button>
    </div>
  </div>
</div>

<div id="dealNoticeModal" class="modal-overlay hidden">
  <div class="modal-box deal-warn-box deal-notice-box" role="alertdialog" aria-modal="true" aria-labelledby="dealNoticeTitle">
    <div class="deal-warn-icon"><i class="fas fa-circle-question"></i></div>
    <h3 id="dealNoticeTitle" class="deal-warn-title"></h3>
    <div id="dealNoticeBody" class="deal-warn-body"></div>
    <div id="dealNoticeError" class="auth-error hidden"></div>
    <div id="dealNoticeActions" class="deal-warn-actions"></div>
  </div>
</div>

<div id="dealAskModal" class="modal-overlay hidden">
  <div class="modal-box deal-ask-box" role="alertdialog" aria-modal="true" aria-labelledby="dealAskTitle" aria-describedby="dealAskBody">
    <div id="dealAskIcon" class="deal-ask-icon"><i class="fas fa-handshake"></i></div>
    <h3 id="dealAskTitle" class="deal-ask-title"></h3>
    <div id="dealAskBody" class="deal-ask-body"></div>
    <div class="deal-ask-actions">
      <button id="dealAskCancel" class="deal-btn" onclick="dlAskAnswer(false)">Cancel</button>
      <button id="dealAskOk" class="deal-btn deal-btn-primary" onclick="dlAskAnswer(true)">OK</button>
    </div>
  </div>
</div>

<div id="globalToast" class="toast"></div>

