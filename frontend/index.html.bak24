<div id="profilePage" class="page hidden">
  <div class="page-header">
    <button class="back-btn" onclick="goBack()"><i class="fas fa-arrow-left"></i></button>
    <h2>My Profile</h2>
  </div>
  <div class="profile-wrap">
    <div class="profile-avatar-section">
      <div class="profile-avatar-wrap">
        <img id="profilePageAvatar" src="" alt="Profile picture">
        <button type="button" class="avatar-edit-btn" onclick="toggleAvatarMenu(event)" aria-label="Change profile picture"><i class="fas fa-camera"></i></button>

                <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/webp" style="display:none" onchange="handleAvatarPicked(event)">
        <input type="file" id="avatarCameraInput" accept="image/*" capture="user" style="display:none" onchange="handleAvatarPicked(event)">

        <div class="avatar-menu hidden" id="avatarMenu">
          <button type="button" onclick="pickAvatar('camera')"><i class="fas fa-camera"></i> Take a photo</button>
          <button type="button" onclick="pickAvatar('file')"><i class="fas fa-image"></i> Choose from device</button>
          <button type="button" class="avatar-menu-danger hidden" id="avatarRemoveBtn" onclick="removeAvatar()"><i class="fas fa-trash"></i> Remove picture</button>
        </div>
      </div>
      <div id="profileSidebarName" class="profile-name"></div>
      <div id="profileSidebarEmail" class="profile-email-sm"></div>
      <div id="profileRoleBadges" class="role-badges" style="justify-content:center;margin-top:8px"></div>
    </div>
    <div class="profile-nav">
      <button class="profile-nav-btn active" onclick="switchProfileTab('details')"><i class="fas fa-user"></i> Personal Info</button>
      <button class="profile-nav-btn" onclick="switchProfileTab('security')"><i class="fas fa-lock"></i> Password</button>
      <button class="profile-nav-btn" onclick="switchProfileTab('stats')"><i class="fas fa-chart-bar"></i> Stats</button>
    </div>
    <div id="profileTab-details" class="profile-tab profile-card" data-enter-flow>
      <div class="form-row">
        <div class="form-group"><label>First Name</label><input type="text" id="profileFirstName" autocomplete="off"></div>
        <div class="form-group"><label>Last Name</label><input type="text" id="profileLastName" autocomplete="off"></div>
      </div>
      <div class="form-group"><label>Email</label><input type="email" id="profileEmail" disabled autocomplete="off"></div>
      <div class="form-group"><label>Phone</label><input type="tel" id="profilePhone" inputmode="tel" maxlength="17" oninput="sanitisePhone(this)" autocomplete="off"></div>
      <div class="form-group"><label>Pincode</label><input type="text" id="profilePincode" maxlength="6" autocomplete="off"></div>
      <p id="profileDetailsMsg" class="profile-msg hidden"></p>
      <button class="btn-primary" data-enter-submit onclick="saveProfileDetails()">Save Changes</button>
    </div>
    <div id="profileTab-security" class="profile-tab profile-card hidden" data-enter-flow>
      <div class="form-group"><label>Current Password</label><div class="password-wrap"><input type="password" id="currentPassword" autocomplete="current-password"><button type="button" class="pw-toggle" onclick="togglePassword('currentPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
      <div class="form-group"><label>New Password</label><div class="password-wrap"><input type="password" id="newPassword" autocomplete="new-password"><button type="button" class="pw-toggle" onclick="togglePassword('newPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
      <div class="form-group"><label>Confirm New Password</label><div class="password-wrap"><input type="password" id="confirmNewPassword" autocomplete="new-password"><button type="button" class="pw-toggle" onclick="togglePassword('confirmNewPassword', this)"><i class="fas fa-eye-slash"></i></button></div></div>
      <p id="profileSecurityMsg" class="profile-msg hidden"></p>
      <button class="btn-primary" onclick="changePassword()">Update Password</button>
    </div>
    <div id="profileTab-stats" class="profile-tab profile-card hidden">
      <div class="stats-grid">
        <div class="stat-card"><div class="stat-card-icon" style="background:#E0F2FE;color:#0EA5E9"><i class="fas fa-list"></i></div><div><strong id="statListingsCount">0</strong><span>Listings</span></div></div>
        <div class="stat-card"><div class="stat-card-icon" style="background:#FCE7F3;color:#DB2777"><i class="fas fa-heart"></i></div><div><strong id="statSavedCount">0</strong><span>Saved</span></div></div>
        <div class="stat-card"><div class="stat-card-icon" style="background:#D1FAE5;color:#10B981"><i class="fas fa-comments"></i></div><div><strong id="statChatsCount">0</strong><span>Chats</span></div></div>
        <div class="stat-card"><div class="stat-card-icon" style="background:#FEF3C7;color:#F59E0B"><i class="fas fa-file-invoice-dollar"></i></div><div><strong id="statEmiCount">0</strong><span>EMI Apps</span></div></div>
      </div>
      <div class="member-since">Member since <span id="statMemberSince">—</span></div>
    </div>
  </div>
</div>

