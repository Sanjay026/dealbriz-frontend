<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0A1628">
<meta name="description" content="DealBriz is India's trusted marketplace to buy and sell used cars, bikes, phones, furniture, electronics & more locally. Safe, simple, and near you.">
<meta name="keywords" content="buy sell used products, used cars near me, second hand bikes, sell old phone, used furniture chandigarh, dealbriz">
<meta name="author" content="DealBriz">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://dealbriz.com/">
<link rel="preconnect" href="https://www.googletagmanager.com">
<link rel="icon" type="image/png" href="/logo.png?v=20261027">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261003b">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>DealBriz – Buy & Sell Near You</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css?v=20261031a">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
